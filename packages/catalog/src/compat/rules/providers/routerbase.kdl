// RouterBase (routerbase.com): OpenAI-compatible gateway serving chat models
// from several labs (Anthropic, OpenAI, Google, DeepSeek, Qwen, GLM, Kimi,
// MiniMax) behind one `sk-rb-...` key. Chat Completions only.

provider "routerbase" {
	default-model "deepseek/deepseek-v4.1-flash"
	env "ROUTERBASE_API_KEY"
	// The authored seed below is RouterBase's own record for these ids. Other
	// hosts serve the same `vendor/name` ids with their own limits and
	// capabilities, so the generator must not backfill from them.
	skip-cross-provider-reference-fills #true
	discovery label="RouterBase"

	// Bundled roster, so the provider is selectable before first discovery.
	// Runtime `/v1/models` discovery is additive (no
	// `dynamic-models-authoritative`): it keeps these rows, takes each row's
	// live `context_length` / `max_completion_tokens`, and adds ids RouterBase
	// ships later. The endpoint also lists image, video, audio and embedding
	// models; runtime/behavior.kdl drops them by their `modality` field.
	//
	// Costs are what RouterBase charges per 1M tokens, not the list price that
	// `/v1/models` reports under `pricing` (RouterBase bills a per-model
	// discount off list), which is why discovery never reads `pricing`. A row
	// with no cache tariff bills cached input at the input rate, so its
	// cache-read equals input. RouterBase publishes no separate cache-write
	// rate for these rows.
	// Limits and tool/vision/reasoning flags match RouterBase's `/v1/models`
	// (`context_length`, `max_completion_tokens`, `input_modalities`,
	// `supported_parameters`).
	seed api="openai-completions" base-url="https://routerbase.com/v1" bundle="always" {
		model "anthropic/claude-fable-5" name="Claude Fable 5" {
			reasoning #true
			input "text" "image"
			cost input=10 output=50 cache-read=1 cache-write=0
			limits context=1000000 max-tokens=128000
			supports-tools #true
		}
		model "anthropic/claude-haiku-4.5" name="Claude Haiku 4.5" {
			reasoning #true
			input "text" "image"
			cost input=0.95 output=4.75 cache-read=0.1 cache-write=0
			limits context=200000 max-tokens=64000
			supports-tools #true
		}
		model "anthropic/claude-opus-4.5" name="Claude Opus 4.5" {
			reasoning #true
			input "text" "image"
			cost input=4.75 output=23.75 cache-read=0.5 cache-write=0
			limits context=200000 max-tokens=64000
			supports-tools #true
		}
		model "anthropic/claude-opus-4.6" name="Claude Opus 4.6" {
			reasoning #true
			input "text" "image"
			cost input=4.75 output=23.75 cache-read=0.5 cache-write=0
			limits context=1000000 max-tokens=128000
			supports-tools #true
		}
		model "anthropic/claude-opus-4.7" name="Claude Opus 4.7" {
			reasoning #true
			input "text" "image"
			cost input=4.75 output=23.75 cache-read=0.5 cache-write=0
			limits context=1000000 max-tokens=128000
			supports-tools #true
		}
		model "anthropic/claude-opus-4.8" name="Claude Opus 4.8" {
			reasoning #true
			input "text" "image"
			cost input=4.75 output=23.75 cache-read=0.5 cache-write=0
			limits context=1000000 max-tokens=128000
			supports-tools #true
		}
		model "anthropic/claude-opus-5" name="Claude Opus 5" {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-read=0.5 cache-write=0
			limits context=1000000 max-tokens=128000
			supports-tools #true
		}
		model "anthropic/claude-sonnet-4.5" name="Claude Sonnet 4.5" {
			reasoning #true
			input "text" "image"
			cost input=2.85 output=14.25 cache-read=0.3 cache-write=0
			limits context=200000 max-tokens=64000
			supports-tools #true
