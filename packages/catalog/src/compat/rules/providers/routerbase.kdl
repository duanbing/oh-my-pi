			limits context=1048576 max-tokens=131072
			supports-tools #true
		}
	}

	// RouterBase's Chat Completions request schema types `max_tokens`;
	// `max_completion_tokens` is not a typed field there.
	max-tokens-field "max_tokens"
	// System prompts travel as `system`: the gateway lifts `system` messages
	// into the upstream system prompt, and has no `developer` role.
	supports-developer-role #false
	supports-store #false
	// Reasoning comes back as `reasoning_content`, on the final message and on
	// streamed deltas.
	reasoning-content-field "reasoning_content"
}
